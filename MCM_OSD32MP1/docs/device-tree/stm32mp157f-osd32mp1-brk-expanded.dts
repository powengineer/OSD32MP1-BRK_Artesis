		reg18 = "/soc/pwr@50001000/reg18";
		usb33 = "/soc/pwr@50001000/usb33";
		pwr_mcu = "/soc/pwr-mcu@50001014";
		pwr_irq = "/soc/pwr@50001020";
		pinctrl = "/soc/pinctrl@50002000";
		gpioa = "/soc/pinctrl@50002000/gpio@50002000";
