/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Octavo Systems OSD32MP1-BRK";
	compatible = "oct,stm32mp157f-osd32mp1-brk\0st,stm32mp157";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x00>;
			clock-names = "cpu";
			operating-points-v2 = <0x01>;
			nvmem-cells = <0x02>;
			nvmem-cell-names = "part_number";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x07>;
			cpu-supply = <0x04>;
			phandle = <0x05>;
		};

		cpu@1 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x01>;
			clocks = <0x03 0x07>;
			cpu-supply = <0x04>;
			phandle = <0x06>;
		};
	};

	cpu0-opp-table {
		bootph-pre-ram;
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x01>;

		opp-650000000 {
			bootph-pre-ram;
			opp-hz = <0x00 0x26be3680>;
			opp-microvolt = <0x124f80>;
			opp-supported-hw = <0x03>;
		};

		opp-800000000 {
			bootph-pre-ram;
			opp-hz = <0x00 0x2faf0800>;
			opp-microvolt = <0x149970>;
			opp-supported-hw = <0x02>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x00 0xc8 0x04 0x00 0xc9 0x04>;
		interrupt-affinity = <0x05 0x06>;
		interrupt-parent = <0x07>;
	};

	watchdog {
		compatible = "arm,smc-wdt";
		arm,smc-id = <0xbc000000>;
		status = "okay";
		timeout-sec = <0x20>;
		phandle = <0x73>;
	};

	psci {
		bootph-some-ram;
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	interrupt-controller@a0021000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		reg = <0xa0021000 0x1000 0xa0022000 0x2000>;
		phandle = <0x07>;
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
		interrupt-parent = <0x07>;
		arm,no-tick-in-suspend;
	};

	clocks {
		bootph-all;
	};

	pm_domain {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "st,stm32mp157c-pd";

		core-ret-power-domain@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;
			#power-domain-cells = <0x00>;
			label = "CORE-RETENTION";
			phandle = <0x74>;

			core-power-domain@2 {
				reg = <0x02>;
				#power-domain-cells = <0x00>;
				label = "CORE";
				phandle = <0x0d>;
			};
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x08>;
			phandle = <0x75>;

			trips {

				cpu-crit {
					temperature = <0x186a0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				cpu-alert {
					temperature = <0x15f90>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x09>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x09>;
					cooling-device = <0x05 0x01 0x01>;
				};
			};
		};
	};

	regulator-booster {
		compatible = "st,stm32mp1-booster";
		st,syscfg = <0x0a>;
		status = "disabled";
		phandle = <0x76>;
	};

	soc {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		interrupt-parent = <0x07>;
		ranges;

		sram@10050000 {
			compatible = "mmio-sram";
			reg = <0x10050000 0x10000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x10050000 0x10000>;
			phandle = <0x77>;
		};

		hwspinlock@4c000000 {
			compatible = "st,stm32-hwspinlock";
			#hwlock-cells = <0x02>;
			reg = <0x4c000000 0x400>;
			clocks = <0x0b 0x52>;
			clock-names = "hsem";
			status = "okay";
			phandle = <0x13>;
		};

		mailbox@4c001000 {
			compatible = "st,stm32mp1-ipcc";
			#mbox-cells = <0x01>;
			reg = <0x4c001000 0x400>;
			st,proc-id = <0x00>;
			interrupts-extended = <0x0c 0x3d 0x04 0x07 0x00 0x65 0x04>;
			interrupt-names = "rx\0tx";
			clocks = <0x0b 0x53>;
			wakeup-source;
			power-domains = <0x0d>;
			status = "okay";
			phandle = <0x6b>;
		};

		rcc@50000000 {
			bootph-all;
			compatible = "st,stm32mp1-rcc-secure\0syscon";
			reg = <0x50000000 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			clock-names = "hse\0hsi\0csi\0lse\0lsi";
			clocks = <0x03 0x00 0x03 0x01 0x03 0x02 0x03 0x03 0x03 0x04>;
			status = "okay";
			phandle = <0x0b>;
		};

		pwr@50001000 {
			bootph-all;
			compatible = "st,stm32mp1,pwr-reg";
			reg = <0x50001000 0x10>;
			st,tzcr = <0x0b 0x00 0x01>;
			status = "okay";
			vdd-supply = <0x0e>;
			vdd_3v3_usbfs-supply = <0x0f>;
			phandle = <0x78>;

			reg11 {
				regulator-name = "reg11";
				regulator-min-microvolt = <0x10c8e0>;
				regulator-max-microvolt = <0x10c8e0>;
				phandle = <0x2d>;
			};

			reg18 {
				regulator-name = "reg18";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				phandle = <0x2e>;
			};

			usb33 {
				regulator-name = "usb33";
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				phandle = <0x5b>;
			};
		};

		pwr-mcu@50001014 {
			compatible = "st,stm32mp151-pwr-mcu\0syscon";
			reg = <0x50001014 0x04>;
			phandle = <0x69>;
		};

		pwr@50001020 {
			compatible = "st,stm32mp1-pwr";
			reg = <0x50001020 0x100>;
			interrupts = <0x00 0x95 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			st,wakeup-pins = <0x10 0x00 0x00 0x10 0x02 0x00 0x11 0x0d 0x00 0x12 0x08 0x00 0x12 0x0b 0x00 0x11 0x01 0x00>;
			phandle = <0x15>;
		};

		pinctrl@50002000 {
			bootph-all;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "st,stm32mp157-pinctrl";
			ranges = <0x00 0x50002000 0xa400>;
			interrupt-parent = <0x0c>;
			hwlocks = <0x13 0x00 0x01>;
			st,package = <0x04>;
			phandle = <0x14>;

			gpio@50002000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x00 0x400>;
				clocks = <0x03 0x15>;
				st,bank-name = "GPIOA";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x00 0x10>;
				phandle = <0x10>;
			};

			gpio@50003000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x1000 0x400>;
				clocks = <0x03 0x16>;
				st,bank-name = "GPIOB";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x10 0x10>;
				phandle = <0x79>;
			};

			gpio@50004000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x2000 0x400>;
				clocks = <0x03 0x17>;
				st,bank-name = "GPIOC";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x20 0x10>;
				phandle = <0x11>;
			};

			gpio@50005000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x3000 0x400>;
				clocks = <0x03 0x18>;
				st,bank-name = "GPIOD";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x30 0x10>;
				phandle = <0x7a>;
			};

			gpio@50006000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x4000 0x400>;
				clocks = <0x03 0x19>;
				st,bank-name = "GPIOE";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x40 0x10>;
				phandle = <0x55>;
			};

			gpio@50007000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x5000 0x400>;
				clocks = <0x03 0x1a>;
				st,bank-name = "GPIOF";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x50 0x10>;
				phandle = <0x7b>;
			};

			gpio@50008000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x6000 0x400>;
				clocks = <0x03 0x1b>;
				st,bank-name = "GPIOG";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x60 0x10>;
				phandle = <0x28>;
			};

			gpio@50009000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x7000 0x400>;
				clocks = <0x03 0x1c>;
				st,bank-name = "GPIOH";
				status = "okay";
				ngpios = <0x10>;
				gpio-ranges = <0x14 0x00 0x70 0x10>;
				phandle = <0x7c>;
			};

			gpio@5000a000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x8000 0x400>;
				clocks = <0x03 0x1d>;
				st,bank-name = "GPIOI";
				status = "okay";
				ngpios = <0x0c>;
				gpio-ranges = <0x14 0x00 0x80 0x0c>;
				phandle = <0x12>;
			};

			gpio@5000b000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0x9000 0x400>;
				clocks = <0x03 0x1e>;
				st,bank-name = "GPIOJ";
				status = "disabled";
				phandle = <0x7d>;
			};

			gpio@5000c000 {
				bootph-all;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				reg = <0xa000 0x400>;
				clocks = <0x03 0x1f>;
				st,bank-name = "GPIOK";
				status = "disabled";
				phandle = <0x7e>;
			};

			fdcan1_mx-0 {
				phandle = <0x66>;

				pins1 {
					pinmux = <0x7d0a>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};

				pins2 {
					pinmux = <0x7e0a>;
					bias-disable;
				};
			};

			fdcan1_sleep_mx-0 {
				phandle = <0x67>;

				pins {
					pinmux = <0x7d11 0x7e11>;
				};
			};

			i2c1_mx-0 {
				phandle = <0x42>;

				pins {
					pinmux = <0x7b06 0x7c06>;
					bias-disable;
					drive-open-drain;
					slew-rate = <0x00>;
				};
			};

			i2c1_sleep_mx-0 {
				phandle = <0x43>;

				pins {
					pinmux = <0x7b11 0x7c11>;
				};
			};

			i2c2_mx-0 {
				phandle = <0x44>;

				pins {
					pinmux = <0x5105 0x6f05>;
					bias-disable;
					drive-open-drain;
					slew-rate = <0x00>;
				};
			};

			i2c2_sleep_mx-0 {
				phandle = <0x45>;

				pins {
					pinmux = <0x5111 0x6f11>;
				};
			};

			i2c5_mx-0 {
				phandle = <0x46>;

				pins {
					pinmux = <0x3005 0x3105>;
					bias-disable;
					drive-open-drain;
					slew-rate = <0x00>;
				};
			};

			i2c5_sleep_mx-0 {
				phandle = <0x47>;

				pins {
					pinmux = <0x3011 0x3111>;
				};
			};

			sdmmc1_mx-0 {
				phandle = <0x25>;

				pins1 {
					pinmux = <0x280d 0x290d 0x2a0d 0x2b0d 0x320d>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x01>;
				};

				pins2 {
					pinmux = <0x2c0d>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x03>;
				};
			};

			sdmmc1_opendrain_mx-0 {
				phandle = <0x26>;

				pins1 {
					pinmux = <0x280d 0x290d 0x2a0d 0x2b0d>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x01>;
				};

				pins2 {
					pinmux = <0x2c0d>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x03>;
				};

				pins3 {
					pinmux = <0x320d>;
					bias-disable;
					drive-open-drain;
					slew-rate = <0x01>;
				};
			};

			sdmmc1_sleep_mx-0 {
				phandle = <0x27>;

				pins {
					pinmux = <0x2811 0x2911 0x2a11 0x2b11 0x2c11 0x3211>;
				};
			};

			spi2_mx-0 {
				phandle = <0x37>;

				pins {
					pinmux = <0x8106 0x8206 0x8306>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x01>;
				};
			};

			spi2_sleep_mx-0 {
				phandle = <0x38>;

				pins {
					pinmux = <0x8111 0x8211 0x8311>;
				};
			};

			spi4_mx-0 {
				phandle = <0x53>;

				pins {
					pinmux = <0x4c06 0x4d06 0x4e06>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x01>;
				};
			};

			spi4_sleep_mx-0 {
				phandle = <0x54>;

				pins {
					pinmux = <0x4c11 0x4d11 0x4e11>;
				};
			};

			tim1_mx-0 {
				phandle = <0x4e>;

				pins {
					pinmux = <0x902>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			tim1_sleep_mx-0 {
				phandle = <0x4f>;

				pins {
					pinmux = <0x911>;
				};
			};

			tim12_pwm_mx-0 {
				phandle = <0x35>;

				pins {
					pinmux = <0x7903>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			tim12_pwm_sleep_mx-0 {
				phandle = <0x36>;

				pins {
					pinmux = <0x7911>;
				};
			};

			tim3_pwm_mx-0 {
				phandle = <0x31>;

				pins {
					pinmux = <0x1503>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			tim3_pwm_sleep_mx-0 {
				phandle = <0x32>;

				pins {
					pinmux = <0x1511>;
				};
			};

			tim4_pwm_mx-0 {
				phandle = <0x33>;

				pins {
					pinmux = <0x1703>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			tim4_pwm_sleep_mx-0 {
				phandle = <0x34>;

				pins {
					pinmux = <0x1711>;
				};
			};

			tim8_mx-0 {
				phandle = <0x50>;

				pins {
					pinmux = <0x8604>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			tim8_sleep_mx-0 {
				phandle = <0x51>;

				pins {
					pinmux = <0x8611>;
				};
			};

			uart4_mx-0 {
				phandle = <0x3c>;

				pins1 {
					pinmux = <0x1209>;
					bias-pull-up;
				};

				pins2 {
					pinmux = <0x6b07>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			uart4_idle_mx-0 {
				phandle = <0x3d>;

				pins1 {
					pinmux = <0x1209>;
					bias-pull-up;
				};

				pins2 {
					pinmux = <0x6b11>;
				};
			};

			uart4_sleep_mx-0 {
				phandle = <0x3e>;

				pins {
					pinmux = <0x1211 0x6b11>;
				};
			};

			uart5_mx-0 {
				phandle = <0x3f>;

				pins1 {
					pinmux = <0x1c0f>;
					bias-disable;
				};

				pins2 {
					pinmux = <0x1d0f>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			uart5_idle_mx-0 {
				phandle = <0x40>;

				pins1 {
					pinmux = <0x1c0f>;
					bias-disable;
				};

				pins2 {
					pinmux = <0x1d11>;
				};
			};

			uart5_sleep_mx-0 {
				phandle = <0x41>;

				pins {
					pinmux = <0x1c11 0x1d11>;
				};
			};

			uart7_mx-0 {
				phandle = <0x48>;

				pins1 {
					pinmux = <0xf0e>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};

				pins2 {
					pinmux = <0x130e>;
					bias-disable;
				};
			};

			uart7_idle_mx-0 {
				phandle = <0x49>;

				pins1 {
					pinmux = <0xf11>;
				};

				pins2 {
					pinmux = <0x130e>;
					bias-disable;
				};
			};

			uart7_sleep_mx-0 {
				phandle = <0x4a>;

				pins {
					pinmux = <0xf11 0x1311>;
				};
			};

			uart8_mx-0 {
				phandle = <0x4b>;

				pins1 {
					pinmux = <0x4009>;
					bias-disable;
				};

				pins2 {
					pinmux = <0x4109>;
					bias-disable;
					drive-push-pull;
					slew-rate = <0x00>;
				};
			};

			uart8_idle_mx-0 {
				phandle = <0x4c>;

				pins1 {
					pinmux = <0x4009>;
					bias-disable;
				};

				pins2 {
					pinmux = <0x4111>;
				};
			};

			uart8_sleep_mx-0 {
				phandle = <0x4d>;

				pins {
					pinmux = <0x4011 0x4111>;
				};
			};

			usart2_mx-0 {
				phandle = <0x39>;

				pins1 {
					pinmux = <0x5408>;
					bias-disable;
				};

				pins2 {
					pinmux = <0x5508>;
