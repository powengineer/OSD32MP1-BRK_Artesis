		fdcan1_pins_mx = "/soc/pinctrl@50002000/fdcan1_mx-0";
		fdcan1_sleep_pins_mx = "/soc/pinctrl@50002000/fdcan1_sleep_mx-0";
		i2c1_pins_mx = "/soc/pinctrl@50002000/i2c1_mx-0";
