	firmware {

		optee {
			bootph-all;
			compatible = "linaro,optee-tz";
			method = "smc";
			interrupt-parent = <0x07>;
			interrupts = <0x01 0x0f 0x308>;
			phandle = <0x143>;
		};

		scmi {
			bootph-some-ram;
			compatible = "linaro,scmi-optee";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			linaro,optee-channel-id = <0x00>;
			phandle = <0x144>;

			protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x03>;
			};

			protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
				phandle = <0x24>;
			};
		};
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		optee@de000000 {
			reg = <0xde000000 0x2000000>;
			no-map;
		};

		mcuram2@10000000 {
			compatible = "shared-dma-pool";
			reg = <0x10000000 0x40000>;
			no-map;
			phandle = <0x6e>;
		};

		vdev0vring0@10040000 {
			compatible = "shared-dma-pool";
			reg = <0x10040000 0x1000>;
			no-map;
			phandle = <0x6f>;
		};

		vdev0vring1@10041000 {
			compatible = "shared-dma-pool";
			reg = <0x10041000 0x1000>;
			no-map;
			phandle = <0x70>;
		};

		vdev0buffer@10042000 {
			compatible = "shared-dma-pool";
			reg = <0x10042000 0x4000>;
			no-map;
			phandle = <0x71>;
		};

		mcu-rsc-table@10048000 {
			compatible = "shared-dma-pool";
			reg = <0x10048000 0x8000>;
			no-map;
			phandle = <0x72>;
		};

		mcuram@30000000 {
			compatible = "shared-dma-pool";
			reg = <0x30000000 0x40000>;
			no-map;
			phandle = <0x6d>;
		};

		retram@38000000 {
			compatible = "shared-dma-pool";
			reg = <0x38000000 0x10000>;
			no-map;
			phandle = <0x6c>;
		};

		gpu@d4000000 {
			reg = <0xd4000000 0x4000000>;
			no-map;
			phandle = <0x145>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x8000000>;
			alignment = <0x2000>;
			linux,cma-default;
		};
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0xc0000000 0x20000000>;
	};

	aliases {
		i2c4 = "/soc/bus@5c007000/i2c@5c002000";
		i2c1 = "/soc/bus@5c007000/i2c@40012000";
		i2c2 = "/soc/bus@5c007000/i2c@40013000";
		i2c5 = "/soc/bus@5c007000/i2c@40015000";
		serial0 = "/soc/bus@5c007000/serial@40010000";
		serial2 = "/soc/bus@5c007000/serial@4000e000";
		serial5 = "/soc/bus@5c007000/serial@40011000";
		serial7 = "/soc/bus@5c007000/serial@40018000";
		serial8 = "/soc/bus@5c007000/serial@40019000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vin {
		compatible = "regulator-fixed";
		regulator-name = "vin";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x63>;
	};

	led {
		compatible = "gpio-leds";

		red1 {
			label = "LED1_RED";
			gpios = <0x60 0x06 0x01>;
			linux,default-trigger = "heartbeat";
			status = "okay";
			default-state = "off";
		};

		green1 {
			label = "LED1_GRN";
			gpios = <0x60 0x07 0x01>;
			status = "okay";
			default-state = "on";
		};

		red2 {
			label = "LED2_RED";
			gpios = <0x12 0x08 0x01>;
			status = "okay";
			default-state = "off";
		};

		green2 {
			label = "LED2_GRN";
			gpios = <0x12 0x09 0x01>;
			default-state = "off";
		};
	};

	__symbols__ {
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu0_opp_table = "/cpu0-opp-table";
		arm_wdt = "/watchdog";
		intc = "/interrupt-controller@a0021000";
		pd_core_ret = "/pm_domain/core-ret-power-domain@1";
		pd_core = "/pm_domain/core-ret-power-domain@1/core-power-domain@2";
		cpu_thermal = "/thermal-zones/cpu-thermal";
		cpu_alert = "/thermal-zones/cpu-thermal/trips/cpu-alert";
		booster = "/regulator-booster";
